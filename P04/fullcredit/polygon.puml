@startuml
set separator none
skinparam classAttributeIconSize 0
hide circle

class polygon 
{
    +{static}MAX_SIDES: int<<final>>
    -numSides:int
    -points:Point[]
    + addPoint(point : Point)
    + perimeter() : double
    + toString() : String <<override>>
    -{static}lineLength(p1 : Point, p2 : Point) : double
}
